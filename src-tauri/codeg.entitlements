<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Agents run by codeg script other apps (osascript, System Events,
	     browsers). macOS attributes those Apple Events to codeg, and a
	     Developer ID signed app is denied them outright — no prompt — unless
	     it carries this entitlement. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Talk on the Mac listens through the microphone (the codeg-talk
	     helper, which carries it too). Required for the microphone once the
	     app runs with the hardened runtime; harmless without it. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
